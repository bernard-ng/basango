{
  "compilerOptions": {
    "paths": {
      "#api/*": ["../api/src/*"],
      "#db/*": ["../../packages/db/src/*"],
      "#domain/*": ["../../packages/domain/src/*"],
      "#mobile/*": ["./src/*"]
    },
    "strict": true
  },
  "extends": "expo/tsconfig.base",
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
